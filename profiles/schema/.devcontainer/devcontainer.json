{
  "name": "coregraft-example",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "make install",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "tamasfe.even-better-toml", "redhat.vscode-yaml"],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/coregraft-example/.venv/bin/python",
        "editor.formatOnSave": true,
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
      }
    }
  }
}
